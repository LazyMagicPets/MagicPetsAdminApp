@namespace BlazorUI

<MudNavMenu>
    @* Href="" resolves to the app base (/admin/) — the in-app Home route. Href="/" would point
       at the SITE root, leaving the SPA and hitting the base-href fatal when lz-explored is set.
       See CFRequest.js root-canonical redirect. *@
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="SubtenantsPage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.HomeWork">Subtenants</MudNavLink>
            <MudNavLink Href="UsersPage" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.People">Tenant Users</MudNavLink>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
